<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title><%= post.title %> - 게시글 보기</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 40px;
      line-height: 1.6;
    }
    h2 {
      color: #333;
    }
    .meta {
      color: #777;
      font-size: 0.9em;
    }
    .content {
      margin: 20px 0;
      white-space: pre-line;
    }
    .actions {
      margin-top: 20px;
    }
    a {
      margin-right: 10px;
      text-decoration: none;
      color: #007BFF;
    }
    a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>

  <h2><%= post.title %></h2>
  <p><%= post.content %></p>
  <p>작성자: <%= post.author %> | 작성일: <%= post.created_at %></p>

  <% if (files && files.length > 0) { %>
    <h4>첨부파일</h4>

    <% files.forEach(file => { %>
      <p>
        <a href="<%= baseUrl %>/uploads/<%= file.filename %>"
                download="<%= file.original_filename %>">

          <!-- 화면에는 원본 파일명 표시 -->
          <%= file.original_filename %>
        </a>
      </p>
    <% }) %>
  <% } %>

  <div class="actions">
    <a href="<%= baseUrl %>/board/reply/<%= post.id %>">[답글]</a>
    <a href="<%= baseUrl %>/board/edit/<%= post.id %>">[수정]</a>
    <a href="<%= baseUrl %>/board/delete/<%= post.id %>" onclick="return confirm('정말 삭제하시겠습니까?')">[삭제]</a>
    <a href="<%= baseUrl %>/board">[목록]</a>
  </div>

</body>
</html>