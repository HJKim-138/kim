<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>고객센터 게시판</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 40px;
    }
    h2 {
      color: #333;
    }
    a {
      text-decoration: none;
      color: #007BFF;
    }
    a:hover {
      text-decoration: underline;
    }
    ul {
      list-style-type: none;
      padding: 0;
    }
    li {
      margin: 10px 0;
    }
  </style>
</head>
<body>

<header>
  <h2>고객센터 게시판</h2>
  <nav>
    <a href="<%= baseUrl %>/">홈</a> |
    <a href="<%= baseUrl %>/board/new">[글쓰기]</a>
  </nav>
</header>

<main>
  <ul>
    <% posts.forEach(post => { %>
      <li style="margin-left:<%= post.parent_id ? '30px' : '0' %>">
        <span style="color: #7a7a7a; margin-right: 3px;">[<%= post.id %>]</span>

        <a href="<%= baseUrl %>/board/view/<%= post.id %>" style="text-decoration: none;">
          <%# 답글일 경우 화살표 추가 %>
          <%= post.parent_id ? '↳' : '' %> <%= post.title %>
        </a>

        <span style="color: #7a7a7a; font-size: 0.8em;">- <%= post.author %></span>

        <span style="margin-left: 10px; font-size: 0.9em;">
          (<a href="<%= baseUrl %>/board/edit/<%= post.id %>">수정</a> /
           <a href="<%= baseUrl %>/board/delete/<%= post.id %>">삭제</a>)
        </span>

        <% }) %>
  </ul>
</main>

<footer style="margin-top: 40px; color: #aaa; font-size: 0.9em;">
  &copy; 2026 고객센터 시스템
</footer>

</body>
</html>
